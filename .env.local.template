# ── Firebase Admin SDK (SECRET – server only) ──
# Pick ONE way for the server to sign in to Firebase:
#  A) Service-account key: Firebase console → Project settings → Service accounts → Generate new private key,
#     then copy client_email and private_key below.
#  B) Path to that JSON file instead:  FIREBASE_SERVICE_ACCOUNT_PATH=C:/keys/atmos-service-account.json
#  C) No key (if your organisation blocks key creation): set FIREBASE_USE_ADC=true and run once:
#     gcloud auth application-default login --scopes=https://www.googleapis.com/auth/cloud-platform,https://www.googleapis.com/auth/firebase.database,https://www.googleapis.com/auth/userinfo.email
# Run `npm run doctor` to check the result.
FIREBASE_USE_ADC=false
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_PROJECT_ID=atmoscareer-3668c
FIREBASE_DATABASE_URL=https://atmoscareer-3668c-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@atmoscareer-3668c.iam.gserviceaccount.com
# Keep the quotes; \n sequences are converted to real newlines at runtime.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# ── Cloudinary (SECRET – server only) ──
# Cloudinary console → Settings → API Keys
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=replace-me
CLOUDINARY_RESUME_FOLDER=atmos-careers/resumes

# ── Admin sessions (SECRET) ──
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars
SESSION_MAX_AGE_HOURS=8

# ── Resume upload rules ──
RESUME_MAX_SIZE_MB=5
RESUME_ALLOW_WORD=true

# ── Optional email notifications (SMTP). Leave EMAIL_ENABLED=false to disable. ──
EMAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-me
SMTP_PASS=replace-me
EMAIL_FROM="Atmos Lifestyle Careers <careers@example.com>"
