    "job_site_engineer": {
      "title": "Senior Site Engineer",
      "description": "<h2>About the role</h2><p>Lead site execution for our residential community in Whitefield, making sure every tower is built to plan, on schedule and safely.</p><h3>What you will do</h3><ul><li><p>Plan and supervise daily civil and finishing work with contractors</p></li><li><p>Run quality checks on structure, waterproofing and MEP</p></li><li><p>Report weekly progress to the project head</p></li></ul><h3>What we are looking for</h3><ul><li><p>B.E./B.Tech in Civil Engineering</p></li><li><p>5+ years on residential high-rise projects</p></li><li><p>Working knowledge of AutoCAD and MS Project</p></li></ul><p>We offer a competitive salary, performance incentives and medical cover for your family.</p>",
      "departmentId": "dept_construction",
      "employmentType": "full_time",
      "location": "Whitefield, Bengaluru",
      "vacancies": 3,
      "applicationDeadline": 1797359399999,
      "status": "published",
      "isActive": true,
      "createdAt": 1792218600000,
      "updatedAt": 1792218600000,
      "createdBy": "admin_default",
      "publishedAt": 1792218600000,
      "closedAt": null
    },
    "job_sales_manager": {
      "title": "Sales Manager – Villas",
      "description": "<h2>About the role</h2><p>Own sales for our premium villa project and guide buyers from first visit to registration.</p><h3>What you will do</h3><ul><li><p>Conduct site visits and walkthroughs for walk-in and channel-partner leads</p></li><li><p>Negotiate and close bookings against monthly targets</p></li><li><p>Work with CRM on agreements and payment follow-ups</p></li></ul><h3>What we are looking for</h3><ul><li><p>4+ years selling residential real estate in Bengaluru</p></li><li><p>Strong spoken English and Kannada or Hindi</p></li><li><p>Comfortable with CRM tools</p></li></ul><p>We offer a competitive salary, performance incentives and medical cover for your family.</p>",
      "departmentId": "dept_sales",
      "employmentType": "full_time",
      "location": "Sarjapur Road, Bengaluru",
