    "job_presales": {
      "title": "Presales Executive",
      "description": "<h2>About the role</h2><p>Be the first voice our prospective buyers hear: qualify leads and book site visits for the sales team.</p><h3>What you will do</h3><ul><li><p>Call and follow up on leads from digital campaigns and portals</p></li><li><p>Qualify budget, location and timelines</p></li><li><p>Schedule and confirm site visits</p></li></ul><h3>What we are looking for</h3><ul><li><p>1–3 years in presales or inside sales</p></li><li><p>Clear, friendly phone manner</p></li><li><p>Graduate in any discipline</p></li></ul><p>We offer a competitive salary, performance incentives and medical cover for your family.</p>",
      "departmentId": "dept_presales",
      "employmentType": "full_time",
